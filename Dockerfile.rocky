FROM rockylinux:9

# Install required packages for VNC server and noVNC
RUN dnf install -y epel-release && \
    dnf install -y \
    xorg-x11-server-Xvfb \
    x11vnc \
    fluxbox \
    xterm \
    python3 \
    python3-pip \
    git \
    procps-ng \
    net-tools \
    which \
    novnc \
    && dnf clean all

# Install Playwright
RUN pip3 install playwright && \
    python3 -m playwright install chromium && \
    python3 -m playwright install-deps chromium

# Create working directory
WORKDIR /app

# Copy scripts
COPY setup_vnc_rocky.sh /app/
COPY run_test_rocky.sh /app/
COPY verify_novnc.py /app/

# Make scripts executable
RUN chmod +x /app/setup_vnc_rocky.sh /app/run_test_rocky.sh /app/verify_novnc.py

# Expose ports
EXPOSE 5999 6080

# Default command
CMD ["/app/run_test_rocky.sh"]
